{
    "id": "ea_app",
    "name": "EA App",
    "version": "2026.10.3",
    "release_note": {
        "version": "2026.10.3",
        "text": "New option on the plugin's card: sync your library when PlayDate starts."
    },
    "min_core_version": "2026.10.5",
    "platform": "ea_app",
    "author": "RobbyRatpoison",
    "source": "github:RobbyRatpoison/playdate-plugin-ea-app",
    "launcher": {
        "required": true,
        "name": "EA App",
        "exe_name": "EADesktop.exe",
        "installer": {
            "url": "https://origin-a.akamaihd.net/EA-Desktop-Client-Download/installer-releases/EAappInstaller.exe",
            "type": "exe",
            "winearch": "win64",
            "win_version": "win10",
            "winetricks": [
                "vcrun2022",
                "d3dcompiler_47",
                "corefonts"
            ],
            "env": {
                "EAX_LAUNCH_CLIENT": "0"
            },
            "exe_name": "EALauncher.exe",
            "post_install_dlls": [
                "lib/vkd3d/x86_64-windows/libvkd3d-1.dll",
                "lib/vkd3d/x86_64-windows/libvkd3d-shader-1.dll"
            ]
        }
    },
    "platform_status": {
        "windows": "untested",
        "linux": "working",
        "mac": "untested"
    }
}
